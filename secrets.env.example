# ---------------------------------------------------------------------------
# Machine-local paths for the RL / PPO pipeline.
#
#   cp secrets.env.example secrets.env      # then edit the values below
#
# secrets.env is git-ignored, so nothing in it ever reaches the repository.
# Every key here can equally be set as an environment variable, which takes
# precedence over this file:
#
#   PPO_QUADRIGA_PATH=/opt/quadriga_src python -m ppo train --code 1-1-1
#
# Read by ppo/paths.py. Values may be quoted; ~ is expanded.
# ---------------------------------------------------------------------------

# Needed ONLY by `--backend matlab`. Absolute path to the QuaDRiGa
# "quadriga_src" folder. Nothing else in the repo requires it: the default
# `pyqd` backend computes the same physics in-process, and the analytic
# backend, the test suite and every plotting/analysis script never touch
# MATLAB. Uncomment and edit only if you want the MATLAB oracle.
#PPO_QUADRIGA_PATH=/path/to/quadriga_src

# --- Optional overrides. All default to a repo-relative location, so leave
# --- them commented out unless you keep runs or caches outside the repo.

# .m files added to the MATLAB path (ppo_world_setup, ppo_sinr_eval, ...).
#PPO_MATLAB_PATH=./matlab

# Training run directories written by `python -m ppo train`.
#PPO_RUNS_DIR=./ppo_runs

# Legacy per-code evaluation logs (plot_trajectories.py reads these).
#PPO_TEST_LOG_DIR=./test_logs

# Cross-run ledger CSV, one row per finished run.
#PPO_LEDGER_PATH=./training_log.csv

# On-disk cache of MATLAB-written MBS power maps (large; safe to delete).
#PPO_CACHE_DIR=./cache_mbs_maps

# On-disk cache of pyqd-written MBS power maps (large; safe to delete).
# Kept separate from PPO_CACHE_DIR on purpose -- the two caches use different
# key schemes and must never share a namespace.
#PPO_PYQD_CACHE_DIR=./cache_pyqd_maps
